# Turso Database Configuration (Remote)
# Get these values from your Turso Dashboard (https://turso.tech)

LIBSQL_DB_URL=libsql://your-database-name-username.turso.io
LIBSQL_DB_TOKEN=your-long-temp-read-write-token-here

VITE_LIBSQL_DB_URL=https://your-database-name-username.turso.io
VITE_LIBSQL_DB_TOKEN=your-long-temp-read-write-token-here

# Note: If these variables are not defined, the application
# will automatically default to a local SQLite database named 'cosmeticos.db'.

# Master offline-login key: a long random secret, never a memorable/guessable string.
# Generate your own, e.g.: python3 -c "import secrets,string;print('DERM-'+'-'.join(''.join(secrets.choice(string.ascii_uppercase+string.digits) for _ in range(6)) for _ in range(4)))"
VITE_MASTER_LICENSE_KEY=your-long-random-master-key-here
