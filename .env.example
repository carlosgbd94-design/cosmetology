# Turso Database Configuration (Remote)
# Get these values from your Turso Dashboard (https://turso.tech)

LIBSQL_DB_URL=libsql://your-database-name-username.turso.io
LIBSQL_DB_TOKEN=your-long-temp-read-write-token-here

# Note: If these variables are not defined, the application 
# will automatically default to a local SQLite database named 'cosmeticos.db'.
